{
    "name": "memotech/shopware-performance-examples",
    "description": "Companion code for 'Shop-Performance in 30 Tagen'",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mehmet Goekce",
            "email": "info@memotech.ch"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpunit/phpunit": "^10.5",
        "spatie/phpunit-snapshot-assertions": "^5.1",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/cache": "^7.0|^8.0",
        "vincentlanglet/twig-cs-fixer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Memotech\\ShopwarePerformance\\": "chapters/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Memotech\\ShopwarePerformance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "analyze": "phpstan analyse",
        "analyze:shopware": "phpstan analyse -c phpstan-shopware.neon",
        "cs": "phpcs --standard=PSR12 chapters/",
        "cs:fix": "phpcbf --standard=PSR12 chapters/",
        "twig": "twig-cs-fixer lint",
        "twig:fix": "twig-cs-fixer lint --fix"
    },
    "config": {
        "sort-packages": true
    }
}
