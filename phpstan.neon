includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 6
    paths:
        - chapters
        - tests
    excludePaths:
        # chapters/*/scripts/*.php wird geprueft (MEM-322): error-budget.php ruft
        # PerformanceBudgetService, ein umbenannter Aufruf faellt sonst nur im
        # PHPUnit-Test auf. Die Ausnahme kostete 0 Fehler, als sie fiel.

        # Controllers extending Shopware/Symfony base classes
        - chapters/*/src/Controller/*.php

        # Subscribers implementing Symfony EventSubscriberInterface
        - chapters/*/src/Subscriber/*.php

        # Commands extending Symfony Command
        - chapters/*/src/Command/*.php

        # Migrations extending Shopware MigrationStep
        - chapters/*/src/Migration/*.php

        # Indexers extending Shopware EntityIndexer
        - chapters/*/src/Indexer/*.php

        # MessageQueue handlers using Shopware Message types
        - chapters/*/src/MessageQueue/*.php

        # Elasticsearch extensions using Shopware ES classes
        - chapters/*/src/ElasticsearchExtension/*.php

        # Plugin-Klasse (Shopware Plugin)
        - chapters/12-real-user-monitoring/RumMonitoring/src/RumMonitoring.php

        # Theme-Plugin-Klasse (Shopware Plugin + ThemeInterface)
        - chapters/16-shopware-themes/PerformanceTheme/src/PerformanceTheme.php

        # Plugin-Klasse (Shopware Plugin)
        - chapters/21-third-party-scripts/ThirdPartyScripts/src/ThirdPartyScripts.php

        # Plugin-Klasse (Shopware Plugin)
        - chapters/19-mobile-performance/MobilePerformance/src/MobilePerformance.php

        # Plugin-Klasse (Shopware Plugin) und Monolog-Processor (Monolog nicht installiert)
        - chapters/20-ab-testing/AbTesting/src/AbTesting.php
        - chapters/20-ab-testing/AbTesting/src/Log/ExperimentLogProcessor.php

        # Skizze, ausdruecklich nicht lauffaehig (Kopfkommentar der Datei):
        # Datenquellen, die jedes Team selbst anbindet. Nur diese Datei - eine
        # pauschale Ausnahme fuer App\Service verdeckte frueher Aufrufe auf
        # Methoden, die es nicht gibt (MEM-317). OkrProgressService wird seit
        # MEM-331 geprueft, gegen die Schnittstellen in tests/Unit/fixtures/ch15-*
        - chapters/15-langfristiger-plan/src/AnnualPerformanceReportService.php

    # Ein Muster, das nichts trifft, ist ein Fehler (MEM-332): 17 Muster trafen
    # nichts mehr, eines davon ("Strict comparison .+ will always evaluate to")
    # haette vertippte Literale wie $overall === 'nodata' verdeckt. Ein neues
    # Muster nur zusammen mit dem Fehler, den es unterdrueckt. Folge: Ein Teillauf
    # auf ein Verzeichnis meldet die Muster, die dort nichts treffen (rc 1);
    # einzelne Dateien oder das ganze Projekt pruefen.
    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Shopware classes not installed (Book examples)
        -
            message: '#Shopware\\#'

        # Symfony classes not installed (Book examples)
        -
            message: '#Symfony\\#'

        # Doctrine DBAL not installed
        -
            message: '#Doctrine\\DBAL\\#'

        # PerformanceExamples namespace (src/ not autoloaded, loaded via require_once in tests)
        -
            message: '#PerformanceExamples\\#'

        # PHPUnit dynamic calls in tests (common pattern)
        -
            message: '#Dynamic call to static method PHPUnit\\#'

        # Strict rules - relaxed for book examples
        -
            identifier: empty.notAllowed
        -
            identifier: ternary.shortNotAllowed

        # Iterable value type (too noisy for examples)
        -
            identifier: missingType.iterableValue

        # Unused constants (book examples may not use all constants)
        -
            message: '#Constant .+ is unused#'

        # Kein '#Offset .+ does not exist#' (MEM-322): verdeckte vertippte
        # Array-Schluessel wie $row['usedPercent'], ohne dass ein Fehler darunter lag
