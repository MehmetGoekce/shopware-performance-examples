# Shopware Performance Examples
# Kopieren zu .env und anpassen

# Database
DATABASE_URL=mysql://root:root@127.0.0.1:3306/shopware

# Redis
REDIS_URL=redis://localhost:6379

# Redis Sentinel (Kapitel 10)
REDIS_SENTINEL_HOSTS=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_MASTER=mymaster

# App
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=your-secret-here
APP_URL=http://localhost:8000
