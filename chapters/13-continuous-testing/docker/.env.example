# LHCI Server Umgebungsvariablen
#
# Kopieren zu .env und anpassen:
#   cp .env.example .env
#
# Token generieren:
#   openssl rand -hex 16

# LHCI Server Port
LHCI_PORT=9001

# Build Token (für lighthouserc.js upload)
# Generieren: openssl rand -hex 16
LHCI_TOKEN=your-secret-token-here

# Optional: PostgreSQL (für größere Deployments)
# POSTGRES_USER=lhci
# POSTGRES_PASSWORD=secure-password-here
# POSTGRES_DB=lhci

# Optional: Basic Auth für Dashboard
# LHCI_BASIC_AUTH_USERNAME=admin
# LHCI_BASIC_AUTH_PASSWORD=secure-password

# Optional: SSL/TLS
# LHCI_HOST=lhci.ihr-server.de
# SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
