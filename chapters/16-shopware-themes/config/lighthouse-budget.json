  "metadata": {
    "shopwareVersion": "6.6+",
    "themeType": "performance-optimized",
    "lastUpdated": "2024-12-26",
    "notes": [
      "Budget basiert auf 3G Mobilfunk (1.6 Mbps, 150ms RTT)",
      "LCP-Ziel: 2.5s (Good), FCP-Ziel: 1.8s (Good)",
      "JavaScript-Limit: 300 KB (nach @StorefrontBootstrap + Plugin-Entfernung)",
      "CSS-Limit: 150 KB (nach selektiven Bootstrap-Imports)"
    ]
  }
