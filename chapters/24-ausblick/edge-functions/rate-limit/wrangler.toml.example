# Kapitel 24: Rate-Limit-Worker Konfiguration
# Ausblick – Neue Technologien und Trends
#
# Kopieren als wrangler.toml und anpassen. Rate Limiting Binding ab
# Wrangler 4.36.0; period nur 10 oder 60 (Sekunden). Das Limit gilt je
# Cloudflare-Standort und ist bewusst ungenau.
# @see https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/

name = "shopware-rate-limit"
main = "src/index.js"
compatibility_date = "2024-01-01"

# Nur teure Routen: Workers laufen vor dem Cache, auf "/*" zaehlten auch CSS,
# JS und Bilder mit, und normale Besucher stiessen nach wenigen Seiten ans Limit
routes = [
    { pattern = "shop.example.com/search*", zone_name = "example.com" },
    { pattern = "shop.example.com/account/login*", zone_name = "example.com" }
]

[[ratelimits]]
name = "RATE_LIMITER"
namespace_id = "1001"
simple = { limit = 100, period = 60 }
