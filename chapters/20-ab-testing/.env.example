# A/B Testing & Performance Experiments - Environment Variables

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=shopware
DB_PASSWORD=shopware
DB_NAME=shopware

# Redis (optional, für Feature Flag Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty (optional)
PAGERDUTY_INTEGRATION_KEY=your-integration-key

# Email Alerts
ALERT_EMAIL=performance-team@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-password

# Experiment Settings
DEFAULT_CONFIDENCE_LEVEL=0.95
MIN_SAMPLE_SIZE=1000
AUTO_PAUSE_ON_BUDGET_EXCEEDED=true

# Performance Budgets (Global Defaults)
GLOBAL_LCP_BUDGET=2500
GLOBAL_FID_BUDGET=100
GLOBAL_CLS_BUDGET=0.1
GLOBAL_TTFB_BUDGET=600

# Feature Flags
FEATURE_FLAGS_CACHE_TTL=300
ENABLE_GRADUAL_ROLLOUT=true

# Monitoring
CLIENT_METRICS_SAMPLE_RATE=0.1
SERVER_METRICS_SAMPLE_RATE=1.0
RUM_ENABLED=true

# Data Retention
RETENTION_DAYS=90
AUTO_CLEANUP_ENABLED=true

# Split.io (optional)
SPLITIO_API_KEY=your-api-key

# LaunchDarkly (optional)
LAUNCHDARKLY_SDK_KEY=your-sdk-key

# Development
APP_ENV=production
APP_DEBUG=false
