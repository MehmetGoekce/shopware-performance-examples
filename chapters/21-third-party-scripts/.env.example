# Third-Party Scripts Configuration
# Copy to .env and configure

# Google Tag Manager
GTM_CONTAINER_ID=GTM-XXXXXXX
GTM_ENABLE=true
GTM_STRATEGY=lazy  # immediate, lazy, interaction
GTM_DELAY=2000  # ms for lazy loading

# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_ENABLE=true
GA_ANONYMIZE_IP=true

# Facebook Pixel
FB_PIXEL_ID=XXXXXXXXXXXXXXX
FB_PIXEL_ENABLE=false

# Hotjar
HOTJAR_ID=XXXXXXX
HOTJAR_ENABLE=false

# Consent Management
CONSENT_ENABLE=true
CONSENT_REQUIRED=true
CONSENT_COOKIE_NAME=sw_consent_preferences
CONSENT_LIFETIME=365  # days

# Performance Budgets
BUDGET_MAX_TOTAL_SIZE=500  # KB
BUDGET_MAX_SCRIPT_COUNT=20
BUDGET_MAX_LOAD_TIME=5000  # ms
BUDGET_MAX_BLOCKING_TIME=300  # ms

# Partytown (Web Workers)
PARTYTOWN_ENABLE=false
PARTYTOWN_DEBUG=false

# Script Audit
AUDIT_ENABLE=true
AUDIT_SCHEDULE=0 0 * * 0  # Weekly (cron format)
AUDIT_ALERT_EMAIL=admin@example.com

# Monitoring
MONITORING_ENABLE=true
MONITORING_LOG_LEVEL=info
MONITORING_SLACK_WEBHOOK=

# Server-Side Tagging (Optional)
GTM_SERVER_CONTAINER_URL=
GTM_SERVER_ENABLE=false

# Security
ALLOWED_SCRIPT_DOMAINS=googletagmanager.com,google-analytics.com,facebook.net
BLOCKED_SCRIPT_PATTERNS=doubleclick.net,*/eval-*.js

# Cache
SCRIPT_CACHE_ENABLE=true
SCRIPT_CACHE_TTL=3600  # seconds

# Development
DEBUG_SCRIPTS=false
SHOW_PERFORMANCE_HINTS=false
