<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Erweitert das Cookie-Banner um den Eintrag «Google Tag Manager» -->
        <service id="ThirdPartyScripts\Framework\Cookie\GtmCookieProvider"
                 decorates="Shopware\Storefront\Framework\Cookie\CookieProviderInterface">
            <argument type="service" id="ThirdPartyScripts\Framework\Cookie\GtmCookieProvider.inner"/>
        </service>
    </services>
</container>
