# Environment-Variablen fuer Kap 11 CDN-Integration
#
# Kopieren als .env.local im Shopware-Root und Werte einsetzen.
# .env.local ist in Shopware-Repos gitignored — niemals .env.local committen.

# ============================================================================
# Asset-URLs
# ============================================================================

# Bei Cloudflare-Proxy-Modus: Shop-Domain (CDN ist transparent)
# Bei separater CDN-Domain: z.B. https://cdn.shop.de
ASSET_URL=https://shop.example.com
CDN_URL=https://shop.example.com

# ============================================================================
# Cloudflare-API-Zugang fuer Purge-Operations
# ============================================================================

# API-Token mit "Zone.Cache Purge"-Permission, NICHT der Global-Key.
# Erzeugen: dash.cloudflare.com → My Profile → API Tokens → Create Token
# Template: "Edit Cloudflare Workers" — Permissions auf "Cache Purge" reduzieren.
CLOUDFLARE_API_TOKEN=

# Zone-ID der Domain (dash.cloudflare.com → Domain → Overview rechts unten)
CLOUDFLARE_ZONE_ID=

# ============================================================================
# Optional: Bunny CDN Storage + Pull-Zone
# ============================================================================

# BUNNY_STORAGE_ZONE=
# BUNNY_PULL_ZONE_ID=
# BUNNY_API_KEY=

# ============================================================================
# Optional: S3-kompatibles Cloud-Storage als Origin
# ============================================================================

# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
