# Environment-Variablen fuer Kapitel 11 (CDN-Integration)
#
# Als .env.local im Shopware-Root anlegen und Werte einsetzen.
# .env.local ist in Shopware-Repos gitignored - niemals committen.

# ============================================================================
# CDN-Domain fuer Assets
# ============================================================================
#
# Shopware liest weder ASSET_URL noch CDN_URL von sich aus. CDN_URL ist
# ausschliesslich der Platzhalter, den config/shopware-cdn.yaml referenziert -
# dort wird er auf filesystem.public/theme/asset/sitemap gesetzt.
#
# Im Cloudflare-Proxy-Modus (CDN sitzt vor der Shop-Domain) wird diese Variable
# nicht gebraucht: die Assets behalten die Shop-Domain.
CDN_URL=https://cdn.example.com

# ============================================================================
# Cloudflare-API fuer Purge
# ============================================================================

# API-Token mit der Berechtigung Zone > Cache Purge > Purge, NICHT der Global Key.
# dash.cloudflare.com -> My Profile -> API Tokens -> Create Token -> Custom Token
CLOUDFLARE_API_TOKEN=

# Zone-ID der Domain (Dashboard -> Domain -> Overview, rechte Spalte)
CLOUDFLARE_ZONE_ID=

# ============================================================================
# Optional: Bunny CDN
# ============================================================================

# BUNNY_PULL_ZONE_ID=
# BUNNY_API_KEY=

# ============================================================================
# Optional: S3-kompatibles Storage als Origin
# ============================================================================

# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
