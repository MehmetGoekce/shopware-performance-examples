# MySQL-8.0-Konfiguration fuer Shopware 6
# Kapitel 8: Datenbank-Optimierung
#
# NUR FUER MySQL 8.0. An innodb_redo_log_capacity scheitert MariaDB 10.11 hart -
# mariadbd startet nicht, sondern beendet sich mit
#   [ERROR] mariadbd: unknown variable 'innodb_redo_log_capacity=1G'
# innodb_buffer_pool_instances nimmt MariaDB als Startoption zwar an, die
# Variable gibt es dort seit 10.6 aber nicht mehr; die Zeile wirkt also nicht.
# Fuer MariaDB beide Zeilen durch die MARIADB-Sektion am Dateiende ersetzen.
#
# Kopieren nach: /etc/mysql/mysql.conf.d/shopware.cnf
# Nach Aenderungen: sudo systemctl restart mysql
#
# Die Werte unten gelten fuer das Referenzprofil aus Anhang C: ein Server mit
# 16 GB RAM, auf dem neben MySQL auch PHP-FPM, Redis und nginx laufen. Auf einem
# Server, der nichts als die Datenbank tut, duerfen Buffer Pool und Redo-Log
# deutlich groesser sein - dann aber gemessen, nicht geraten.
#
# @see https://github.com/MehmetGoekce/shopware-performance-examples

[mysqld]

# ==============================================================================
# SPEICHER-EINSTELLUNGEN
# ==============================================================================

# InnoDB Buffer Pool.
# Faustregel "70-80 % des RAM" gilt nur fuer einen Server, auf dem die Datenbank
# allein laeuft. Auf dem 16-GB-Referenzprofil teilen sich MySQL, PHP-FPM, Redis
# und nginx den Speicher - deshalb 4G, nicht 12G.
innodb_buffer_pool_size = 4G

# Buffer Pool Instances. In MariaDB seit 10.6 ohne Wirkung (Variable entfernt).
# MySQL entscheidet das ab Werk selbst und trifft es fuer die allermeisten Shops
# richtig (Default 8; 1, solange der Pool unter 1 GB liegt). Wer den Wert setzt,
# sollte wissen warum: unterhalb von rund 1 GB Pool zwingt MySQL ihn ohne jede
# Meldung im Log auf 1 zurueck - gemessen mit 512 MB Pool und instances = 8.
# Eine Instanz je GB, hoechstens 64, ist eine brauchbare Obergrenze.
innodb_buffer_pool_instances = 4

# Redo-Log. Diese Direktive gibt es nur in MySQL ab 8.0.30.
# NICHT innodb_log_file_size verwenden: seit MySQL 8.0.30 abgekuendigt, in 8.4
# entfernt - und es wirkt weiter, nur anders als gemeint. MySQL rechnet
# innodb_redo_log_capacity = innodb_log_file_size x innodb_log_files_in_group,
# und der zweite Faktor ist ab Werk 2. Aus "2G" werden also 4 GB auf der Platte,
# waehrend SHOW VARIABLES weiter den Vorgabewert 100 MB anzeigt.
# Richtwert: etwa ein Viertel des Buffer Pools.
innodb_redo_log_capacity = 1G
innodb_log_buffer_size = 64M

# Flush-Verhalten: 1 = jede Transaktion sofort auf Platte (ACID),
# 2 = einmal pro Sekunde (schneller, verliert im Crash bis zu 1 s Schreibvorgaenge)
innodb_flush_log_at_trx_commit = 1

# Flush-Methode (O_DIRECT empfohlen fuer Linux)
innodb_flush_method = O_DIRECT

# ==============================================================================
# SHOPWARE-ANFORDERUNGEN
# ==============================================================================

# Shopware setzt beide Werte bei JEDEM Verbindungsaufbau selbst
# (Kernel::initializeDatabaseConnectionVariables): group_concat_max_len auf
# mindestens 320000 und sql_mode ohne ONLY_FULL_GROUP_BY. Serverseitig setzen
# bringt darum nur dann etwas, wenn Sie zusaetzlich
#   SQL_SET_DEFAULT_SESSION_VARIABLES=0
# in die .env schreiben - dann sparen Sie zwei SET-Statements pro Request.
# Ohne diese Variable sind die zwei Zeilen hier reine Absicherung fuer alles,
# was neben Shopware auf dieselbe Datenbank zugreift (Importer, Reports, CLI).
group_concat_max_len = 320000
sql_mode = "STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION"

# ==============================================================================
# VERBINDUNGEN
# ==============================================================================

# Max gleichzeitige Verbindungen. Shopware oeffnet EINE Verbindung je
# PHP-Prozess und Datenbank-Server (mit Read Replica je eine zu Primary und
# Replica), und nur solange der Request laeuft (gemessen, Kapitel 8).
# Richtwert: Summe aller PHP-Prozesse, die gleichzeitig an dieser Datenbank
# haengen - pm.max_children JEDES App-Servers, Message-Consumer, Cronjobs -
# plus Reserve fuer Admin-Zugaenge, Backups und Monitoring.
# Beispiel: 2 App-Server x 50 Worker + 4 Consumer + 10 Reserve = 114
# Mit DATABASE_PERSISTENT_CONNECTION=1 haelt jeder Worker, der schon einen
# Request bedient hat, seine Verbindung auch im Leerlauf, bis wait_timeout.
max_connections = 200

# Timeout fuer inaktive Verbindungen (Sekunden)
wait_timeout = 600
interactive_timeout = 600

# ==============================================================================
# TEMPORAERE TABELLEN
# ==============================================================================

# Groesse fuer temporaere Tabellen im RAM
# Wenn ueberschritten, wird auf Disk geschrieben
tmp_table_size = 256M
max_heap_table_size = 256M

# ==============================================================================
# TABELLEN-CACHE
# ==============================================================================

# Anzahl offener Tabellen-Handles
table_open_cache = 4000
table_definition_cache = 2000

# ==============================================================================
# SORTIERUNG UND JOINS
# ==============================================================================

# Diese Buffer werden PRO VERBINDUNG belegt, sobald sie gebraucht werden.
# Bei max_connections = 200 also mit Bedacht vergroessern.
sort_buffer_size = 4M
join_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M

# ==============================================================================
# SLOW QUERY LOG (WICHTIG!)
# ==============================================================================

# Immer aktivieren - auch in Production
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log

# Queries ueber 1 Sekunde loggen
long_query_time = 1

# log_queries_not_using_indexes NICHT dauerhaft einschalten.
# Die Option ignoriert long_query_time und protokolliert jede Query ohne
# Index-Zugriff - auch die, die in 0,1 ms fertig ist. Gemessen: mit
# long_query_time = 10 landeten 40 von 40 trivialen Queries im Log. Auf einem
# Shop ertraenkt das die echten Slow Queries und entwertet die Auswertung mit
# pt-query-digest. Fuer eine gezielte Index-Jagd stundenweise einschalten:
#   SET GLOBAL log_queries_not_using_indexes = 1;   ... und danach wieder 0
log_queries_not_using_indexes = 0

# ==============================================================================
# PERFORMANCE SCHEMA
# ==============================================================================

# Fuer detaillierte Performance-Analyse. Auf MySQL 8.0 ab Werk an, auf
# MariaDB 10.11 ab Werk AUS - dort ist diese Zeile noetig, plus Neustart.
#
# Achtung bei der Auswertung: die Zaehler des Performance Schema werden bei
# JEDEM Serverstart zurueckgesetzt. Kurz nach einem Neustart meldet eine
# "count_read = 0"-Abfrage praktisch das ganze Schema als ungenutzt. Vor jeder
# solchen Auswertung SHOW GLOBAL STATUS LIKE 'Uptime' pruefen.
performance_schema = ON

# ==============================================================================
# BINARY LOG (fuer Replikation)
# ==============================================================================

# Automatische Bereinigung nach 7 Tagen.
# MySQL 8.0+:
binlog_expire_logs_seconds = 604800
# MySQL 5.7 - NICHT zusaetzlich zur Zeile darueber setzen. Die beiden Optionen
# schliessen sich aus. Hier in der Konfigurationsdatei laesst MySQL 8.0 den
# Server starten und meldet nur
#   [Warning] [MY-011079] ... value of expire_logs_days is ignored
# - die Einstellung wirkt also stillschweigend nicht. Zur Laufzeit ist es ein
# harter Fehler: SET GLOBAL expire_logs_days = 7 endet in ERROR 3683.
# expire_logs_days = 7

# Der Default-Basename ist auf MySQL 8.0 "binlog", nicht mehr "mysql-bin"
# (das war 5.7). Die Dateien heissen also /var/lib/mysql/binlog.000001 usw.

# ==============================================================================
# QUERY CACHE
# ==============================================================================

# HINWEIS: MySQL 8.0+ hat keinen Query Cache mehr!
# Verwenden Sie Redis fuer Application-Level Caching.
# Fuer MySQL 5.7:
# query_cache_type = 0
# query_cache_size = 0

# ==============================================================================
# MARIADB 10.11
# ==============================================================================
# Fuer MariaDB die beiden MySQL-Direktiven oben entfernen und stattdessen:
#
#   # innodb_buffer_pool_instances gibt es seit MariaDB 10.6 nicht mehr -
#   # ersatzlos streichen, der Buffer Pool ist dort nicht in Instanzen geteilt.
#
#   # innodb_redo_log_capacity gibt es nur in MySQL. In MariaDB ist
#   # innodb_log_file_size die aktuelle, nicht abgekuendigte Direktive und meint
#   # genau das, was dort steht - ohne Multiplikation mit einem zweiten Faktor.
#   innodb_log_file_size = 1G
#
# performance_schema = ON ist auf MariaDB ab Werk AUS und deshalb dort noetig
# (Neustart erforderlich); alle uebrigen Zeilen dieser Datei nimmt MariaDB an.
