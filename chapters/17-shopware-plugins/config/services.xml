<?xml version="1.0" ?>
<!--
    Service-Definitionen zu Kapitel 17.

    Als Plugin: nach src/Resources/config/services.xml kopieren und den
    Namespace App\ durch den des Plugins ersetzen.

    Getestet mit Shopware 6.6.10.6 (Dockware).
-->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
           http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Services -->
        <service id="App\Service\OptimizedProductService">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="App\Service\FastIdLookupService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="App\Service\CustomTagInvalidator">
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheInvalidator"/>
        </service>

        <!-- Event-Subscriber -->
        <service id="App\Subscriber\PerformanceAwareSubscriber">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="App\Subscriber\ChangesetAwareSubscriber">
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="App\Subscriber\CacheTagSubscriber">
            <argument type="service" id="event_dispatcher"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Entity-Indexer: der Tag meldet ihn bei dal:refresh:index an -->
        <service id="App\Indexer\OptimizedEntityIndexer">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="shopware.entity_indexer"/>
        </service>

        <!-- Message-Handler: der Tag ersetzt Autoconfiguration -->
        <service id="App\MessageQueue\AsyncProductHandler">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
