# Shopware/Symfony Environment fuer Redis Sentinel
#
# Kopieren als .env.local im Shopware-Root und Werte einsetzen.
# .env.local ist in Shopware-Repos gitignored — niemals .env.local committen.
#
# Quelle: Buch Kap. 10, Abschnitt "Secrets Management".

# Passwort EXAKT gleich wie in /etc/redis/redis-auth.conf auf den Redis-Nodes.
# Auf den Nodes auslesen mit:
#   grep ^requirepass /etc/redis/redis-auth.conf | cut -d'"' -f2
#
# WICHTIG: URL-kodiert eintragen, der Wert landet im Userinfo-Block der DSN.
# Aus "geheim!2026" wird "geheim%212026". Betroffen sind u. a. ! # $ % & + / : ; = ? @
# Kodieren mit:
#   php -r 'echo rawurlencode("geheim!2026"), PHP_EOL;'
REDIS_AUTH_PASSWORD=

# Sentinel-Hosts (3 IP:Port-Paare, gleiche Werte wie in sentinel.conf).
# Immer alle drei angeben — Symfony fragt sie der Reihe nach ab, bis einer
# antwortet. Mit nur einem Eintrag ist der Sentinel selbst der Single Point of
# Failure, den das ganze Setup vermeiden soll.
REDIS_SENTINEL_HOST1=192.168.1.1:26379
REDIS_SENTINEL_HOST2=192.168.1.2:26379
REDIS_SENTINEL_HOST3=192.168.1.3:26379

# Master-Namen aus sentinel.conf ("sentinel monitor <name> ...").
# Zwei getrennte Instanzen: Cache und Sessions brauchen unterschiedliche
# Eviction-Policies und Persistenz, und die gelten pro Instanz.
REDIS_SENTINEL_CACHE=shopware-cache
REDIS_SENTINEL_SESSION=shopware-session
