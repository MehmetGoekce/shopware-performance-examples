# MySQL 8.0 fuer Shopware 6
# Anhang C: Konfigurationen
#
# Datei: /etc/mysql/mysql.conf.d/shopware.cnf
#        (unter Debian/Ubuntu bindet /etc/mysql/my.cnf sowohl conf.d/ als auch
#         mysql.conf.d/ ein; mysql.conf.d/ ist der Ort fuer [mysqld])
#        sudo systemctl restart mysql
#
# Geprueft gegen mysql:8.0 (8.0.46): Startlog ohne Deprecation-Warnung,
# `SHOW VARIABLES` mit den erwarteten Werten.
#
# Die Zahlen unten gehoeren zu einem Server mit 16 GB RAM, auf dem MySQL
# allein laeuft. Wer Shopware, PHP-FPM, Redis und MySQL auf dieselbe Maschine
# legt, rechnet anders — dann bleiben fuer den Buffer Pool eher 25-40 % statt
# 70 %. Die Formeln stehen jeweils im Kommentar.
#
# @see https://github.com/MehmetGoekce/shopware-performance-examples

[mysqld]

# ==============================================================================
# InnoDB Buffer Pool
# ==============================================================================

# 4G ist der Wert fuer den 16-GB-Server aus dem Buch, auf dem AUCH PHP-FPM,
# nginx und zwei Redis-Instanzen laufen. Rechnung fuer diese Maschine:
#   MySQL 4 + PHP-FPM (50 Worker * ~80 MB) 4 + Redis-Cache 4 + Redis-Session 1
#   = 13 GB, der Rest bleibt fuer OS und Dateisystem-Cache.
# Die verbreiteten 70-80 % des RAM gelten fuer einen Server, auf dem MySQL
# allein laeuft — dort waeren es 11G. Rechnen Sie nach, statt die Zahl zu
# uebernehmen: ein Buffer Pool, der den Server ins Swappen bringt, ist
# langsamer als ein kleiner.
innodb_buffer_pool_size = 4G

# Eine Instanz je GB, hoechstens 64. Geprueft: bei einem Pool unter 1 GB setzt
# MySQL den Wert stillschweigend auf 1 zurueck (512M mit instances=8 ergab
# innodb_buffer_pool_instances = 1).
innodb_buffer_pool_instances = 4

# ==============================================================================
# Redo-Log
# ==============================================================================

# WICHTIG: innodb_log_file_size ist seit MySQL 8.0.30 abgekuendigt — und die
# Falle daran ist NICHT, dass es wirkungslos waere. Es wirkt, nur anders als
# gemeint: MySQL rechnet
#   innodb_redo_log_capacity = innodb_log_file_size * innodb_log_files_in_group
# und der zweite Faktor ist ab Werk 2. Aus "innodb_log_file_size = 2G" wird
# also ein 4-GB-Redo-Log.
#
# Sichtbar ist das fast nirgends: SHOW VARIABLES LIKE 'innodb_redo_log_capacity'
# zeigt weiter den Vorgabewert 104857600. Nur das Startlog (MY-013907) und
# SHOW GLOBAL STATUS LIKE 'Innodb_redo_log_capacity_resized' nennen den echten
# Wert — und auf der Platte liegen die Dateien. In 8.0.46 auf frischem Datadir
# nachgestellt:
#   innodb_log_file_size = 512M    -> 1,00 GB unter /var/lib/mysql/#innodb_redo
#   innodb_redo_log_capacity = 512M -> 0,50 GB
#   keines von beiden               -> 0,10 GB
#
# Richtig ist die neue Direktive: sie meint genau das, was dort steht.
# Als Anhaltswert etwa ein Viertel des Buffer Pools, mindestens 512 MB.
innodb_redo_log_capacity = 1G

innodb_log_buffer_size = 64M

# ==============================================================================
# Schreibverhalten
# ==============================================================================

# 1 = jede Transaktion landet vor dem Commit auf der Platte (Vorgabe, sicher).
# 2 = schreibt einmal je Sekunde; ein Serverabsturz kann bis zu eine Sekunde
#     bestaetigter Transaktionen kosten. Fuer einen Shop mit Bestellungen ist
#     das eine bewusste Entscheidung, keine Standardoptimierung.
innodb_flush_log_at_trx_commit = 1

innodb_flush_method = O_DIRECT

# ==============================================================================
# I/O
# ==============================================================================

# Auf SSD/NVMe. Auf rotierenden Platten deutlich niedriger ansetzen.
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# ==============================================================================
# Verbindungen
# ==============================================================================

# Vorgabe ist 151. Richtwert: PHP-FPM-Worker + Worker-Prozesse + Reserve.
max_connections = 200

# Vorgabe ist 28800 Sekunden (8 Stunden). So lange haelt kein Shop-Request
# eine Verbindung; kuerzer raeumt haengengebliebene Verbindungen schneller weg.
wait_timeout = 600
interactive_timeout = 600

# ==============================================================================
# Slow Query Log
# ==============================================================================

# Vorgabe von long_query_time ist 10 Sekunden — damit taucht fast nichts auf.
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# group_concat_max_len steht hier bewusst NICHT. Shopware hebt den Wert
# selbst je Verbindung auf mindestens 320000 an (Kernel.php), die Zeile in
# der my.cnf waere wirkungslos verdoppelt.
