# .env.local fuer Shopware 6 in Produktion
# Anhang C: Konfigurationen
#
# Datei: <shop>/.env.local
#        chmod 640, Eigentuemer root:www-data — diese Datei enthaelt
#        Zugangsdaten. Mit www-data als Eigentuemer koennte der PHP-Prozess
#        seine eigene Zugangsdatendatei ueberschreiben.
#
# Symfony liest .env, dann .env.local, in prod danach .env.prod und
# .env.prod.local; die spaetere Datei gewinnt, .env.prod schlaegt also
# .env.local. Eine .env.local.php (composer dump-env prod) ersetzt alle
# .env-Dateien, solange die Umgebung kein anderes APP_ENV setzt. Was der
# Webserver selbst setzt (FPM env[], Apache SetEnv), schlaegt jede Datei
# (Kapitel 22, Probleme 11 und 13; gemessen MEM-327, 6.6.10.6).
# Shopware liefert .env mit; committet wird nur .env ohne echte Werte.
# .env.local, .env.local.php und .env.*.local stehen in Shopwares
# .gitignore, .env.prod nicht.
#
# Geprueft im Testshop (Shopware 6.6.10.6): mit genau diesen Variablen
# startet der Shop, Cache- und Session-Keys landen in den zwei Redis-
# Instanzen.
#
# @see https://github.com/MehmetGoekce/shopware-performance-examples

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=hier_ein_eigenes_geheimnis
APP_URL=https://shop.example.com

DATABASE_URL=mysql://shopware:passwort@127.0.0.1:3306/shopware

# ============================================================
# Redis
# ============================================================
#
# ZWEI Variablen, nicht eine. config/packages/cache.yaml (Kapitel 7)
# referenziert beide. Fehlt REDIS_SESSION_URL, meldet `cache:clear` trotzdem
# [OK] — und der Shop antwortet danach auf JEDEN Request mit HTTP 500
# (`Environment variable not found: "REDIS_SESSION_URL"`). Im Testshop
# nachgestellt.
#
# Beide Namen sind selbst gewaehlt: Shopware liefert keine REDIS_*-Variable
# mit. Sie muessen zu den Platzhaltern in der eigenen cache.yaml passen.
#
# Zwei Instanzen, weil maxmemory-policy und Persistenz je Instanz gelten und
# nicht je Datenbanknummer (Kapitel 10):
#   Cache   volatile-lru, keine Persistenz
#   Session noeviction oder allkeys-lru, AOF an
REDIS_URL=redis://127.0.0.1:6379
REDIS_SESSION_URL=redis://127.0.0.1:6380

# ============================================================
# Message Queue
# ============================================================
#
# Shopware definiert zwei Transporte, jeden mit eigener Variable. Ohne
# Eintrag gilt doctrine://default?auto_setup=false — die Queue liegt dann in
# der Tabelle `messenger_messages` und ueberlebt einen Neustart.
#
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=false
# MESSENGER_TRANSPORT_LOW_PRIORITY_DSN=doctrine://default?auto_setup=false&queue_name=low_priority
#
# Redis statt Doctrine braucht ein zusaetzliches Paket — 6.6.10.6 liefert nur
# symfony/doctrine-messenger mit. Ohne das Paket bricht jeder
# messenger:*-Befehl ab mit "No transport supports the given Messenger DSN":
#   composer require symfony/redis-messenger
#
# Und: im Redis-DSN ist der Pfad der STREAM-Name, nicht die Datenbanknummer.
# `redis://127.0.0.1:6379/3` legt einen Stream namens "3" an. Shopwares
# eigene .env zeigt es richtig: redis://localhost:6379/messages
#
# Wenn Redis, dann NICHT auf der Cache-Instanz: die laeuft mit volatile-lru
# und ohne Persistenz, dort werden Nachrichten bei Speicherdruck verworfen.
# Dafuer eine eigene Instanz mit noeviction und AOF.

# ============================================================
# Mailer
# ============================================================

MAILER_DSN=smtp://127.0.0.1:25

# ============================================================
# Elasticsearch / OpenSearch
# ============================================================
#
# Das Flex-Rezept fuer 6.6 und neuer legt seit dem 2024-10-01 KEINE
# config/packages/elasticsearch.yaml mehr an; Shops aus 6.4/6.5 oder fruehem
# 6.6 haben meist eine, die nur hosts an OPENSEARCH_URL bindet. Der Bundle
# bindet alles an diese Variablen
# (vendor/shopware/elasticsearch/Resources/config/packages/elasticsearch.yaml).
#
# Das Schema darf fehlen — OpenSearch\ClientBuilder::prependMissingScheme()
# setzt dann "http://" davor. Genau deshalb sollten Sie es ausschreiben: bei
# einem TLS-Cluster waere die stillschweigende Ergaenzung falsch.
#
# OPENSEARCH_URL=http://127.0.0.1:9200
# SHOPWARE_ES_INDEXING_ENABLED=1
# SHOPWARE_ES_INDEX_PREFIX=sw
#
# Danach einmalig: bin/console es:index --no-queue
# Pruefen: curl -s http://127.0.0.1:9200/sw_product/_count ("count" > 0).
# Erst dann die Suche umschalten; vorher antwortet /suggest mit HTTP 500
# (Kapitel 22, Problem 11):
# SHOPWARE_ES_ENABLED=1

# ============================================================
# Secrets
# ============================================================
#
# Echte Passwoerter gehoeren nicht in diese Datei, sondern in Symfonys
# Secrets-Vault:
#   php bin/console secrets:set DATABASE_PASSWORD
# legt sie verschluesselt unter config/secrets/prod/ ab. Referenziert wird
# das NICHT in dieser Datei: %env(DATABASE_PASSWORD)% ist Syntax der
# Container-Konfiguration und gilt nur in config/packages/*.yaml. In einer
# .env-Datei waere es ${DATABASE_PASSWORD}. Beim Deploy einmalig
#   php bin/console secrets:decrypt-to-local --force
# damit der Entschluesselungs-Key nicht dauerhaft auf dem Server liegt.
#
# Das Redis-Passwort wie in Kapitel 10 per Include aus einer chmod-600-Datei.
# @see https://symfony.com/doc/current/configuration/secrets.html
